{
  "name": "job-alert",
  "version": "0.1.0",
  "description": "Scan ATS job boards (Greenhouse/Lever/Ashby) on an interval and alert on keyword matches",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts run",
    "import": "tsx src/index.ts import",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.3",
    "he": "^2.0.0",
    "html-to-text": "^10.0.1",
    "p-limit": "^7.3.3",
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "bin": {
    "job-alert": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true
}
